# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# ── 编辑器 / 系统 ──────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ── 本地临时产物（跨电脑无意义，不要提交） ─────────────
*.log
*.tmp
~$*
.install-state.json

# ── 课件产物（体积大且是二进制，走网盘不走 Git） ────────
# 说明：my-ppt-master 仓库本身不应包含任何 PPTX。
# 如果误把成品拷进来，下面几行可以兜底防止误提交。
*.pptx
*.ppt
*.pdf
*.mp4

# ── 预览器产物（是快照，随时可由 build_preview.py 重新生成） ──
preview.html
